{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViLauncher",
  "mainBinaryName": "ViLauncher",
  "version": "0.5.0",
  "identifier": "com.vipok.vilauncher",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ViPok Launcher",
        "width": 1100,
        "height": 680,
        "minWidth": 900,
        "minHeight": 580,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.modrinth.com; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzNzAxMjIyMjVBRjEwNkIKUldSckVLOGxJaEp3czBvZUhjREdjQVdCNU40TFZNNXNrWWVBa3RkdnFsbFhENGdNbWRmeFpSM0cK",
      "endpoints": [
        "https://github.com/ViPok137/ViLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
